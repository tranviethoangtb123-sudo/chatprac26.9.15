      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "句子和对话",
      "short_name": "句子",
      "description": "检索句子与整组对话",
      "url": "./#sentences",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "对话练习",
      "short_name": "练习",
      "description": "开口练对话",
      "url": "./#practice",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
